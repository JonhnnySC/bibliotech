<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12.0" prefWidth="480.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.senac.back.UsuarioController">
   <padding>
      <Insets top="20.0" right="24.0" bottom="20.0" left="24.0" />
   </padding>
   <children>
      <Label text="Empresa">
         <style>-fx-font-weight: bold; -fx-font-size: 14;</style>
      </Label>
      <GridPane hgap="10.0" vgap="8.0">
         <columnConstraints>
            <ColumnConstraints minWidth="70.0" />
            <ColumnConstraints hgrow="ALWAYS" />
         </columnConstraints>
         <children>
            <Label text="Nome" GridPane.rowIndex="0" />
            <TextField fx:id="txtEmpresaNome" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label text="CNPJ" GridPane.rowIndex="1" />
            <TextField fx:id="txtCnpj" promptText="00.000.000/0000-00" GridPane.columnIndex="1" GridPane.rowIndex="1" />
         </children>
      </GridPane>

      <Separator />

      <Label text="Administrador">
         <style>-fx-font-weight: bold; -fx-font-size: 14;</style>
      </Label>
      <GridPane hgap="10.0" vgap="8.0">
         <columnConstraints>
            <ColumnConstraints minWidth="70.0" />
            <ColumnConstraints hgrow="ALWAYS" />
         </columnConstraints>
         <children>
            <Label text="Nome" GridPane.rowIndex="0" />
            <TextField fx:id="txtNome" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label text="E-mail" GridPane.rowIndex="1" />
            <TextField fx:id="txtEmail" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label text="CPF" GridPane.rowIndex="2" />
            <TextField fx:id="txtCpf" promptText="000.000.000-00" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Label text="Senha" GridPane.rowIndex="3" />
            <PasswordField fx:id="txtSenha" GridPane.columnIndex="1" GridPane.rowIndex="3" />
         </children>
      </GridPane>

      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Button mnemonicParsing="false" onAction="#voltar" text="Voltar" />
            <Button fx:id="btnSalvar" defaultButton="true" mnemonicParsing="false" onAction="#salvarUsuario" text="Criar biblioteca" />
         </children>
      </HBox>
   </children>
</VBox>